# Banco de dados e sessão
DATABASE_URL=
# Banco exclusivo para testes, com nome terminado em _test.
DATABASE_URL_TEST=
SESSION_COOKIE_NAME=comanga_session

# URL do frontend para os links de e-mail
FRONTEND_URL=http://localhost:8080

# Armazenamento interno de capas (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_SOURCE_BYTES=10485760
MEDIA_MAX_SOURCE_PIXELS=40000000
MEDIA_DOWNLOAD_TIMEOUT_MS=10000

# Resend: API HTTPS; remetente de um domínio verificado. Nunca versionar a chave.
RESEND_API_KEY=
RESEND_FROM=

# Ambiente local opcional (nunca usar em produção)
# MEDIA_STORAGE_DRIVER=local
# LOCAL_MEDIA_DIR=/caminho/absoluto/para/capas
# MEDIA_PUBLIC_BASE_URL=http://localhost:3000/local-media
# MAIL_TRANSPORT=local
# LOCAL_MAIL_DIR=/caminho/absoluto/para/emails
# HOST=127.0.0.1
