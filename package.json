{
  "name": "comanga-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:coverage:unit": "npm run test:unit -- --coverage",
    "lint": "eslint . --max-warnings=0",
    "load:test": "node scripts/load-test.js",
    "migrate": "prisma migrate deploy",
    "migrate:test": "node scripts/migrate-test-db.js",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "check": "npm run lint && npm run build && npm run test:coverage:unit",
    "check:integration": "npm run migrate:test && npm run test:coverage",
    "check:online": "npm audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacLeite1309/comanga-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IsaacLeite1309/comanga-api/issues"
  },
  "homepage": "https://github.com/IsaacLeite1309/comanga-api#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.2",
    "pg": "^8.20.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "test-exclude": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
